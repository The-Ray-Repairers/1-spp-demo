Plugins/DLSS/
Plugins/StreamlineNGXCommon/
Plugins/StreamlineCore/
Plugins/StreamlineDLSSG/
Plugins/StreamlineReflex/
__pycache__/
*.pyc

# Local / temporary configuration files
Config/Saved/
DefaultEngine.ini.bak
*.log
*.tmp

# Packages, archives & crash dumps
*.apk
*.aab
*.ipa
*.app
*.dmp
*.crashinfo

# Flythrough benchmark renders (large frame captures)
/renders/

# System & OS files
Thumbs.db
Desktop.ini
.DS_Store
