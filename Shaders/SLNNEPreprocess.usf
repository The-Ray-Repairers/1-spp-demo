#include "/Engine/Public/Platform.ush"

Texture2D<float4> InputTexture;
SamplerState InputSampler;
RWBuffer<float> OutputTensor;
float2 InvOutputSize;

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (DispatchThreadId.x >= 224 || DispatchThreadId.y >= 224) return;

    // We sample from the full-res InputTexture at the corresponding scaled UV
    float2 UV = (float2(DispatchThreadId.xy) + 0.5f) * InvOutputSize;
    float4 Color = InputTexture.SampleLevel(InputSampler, UV, 0);

    // The candy-9-clean model expects RGB in [0, 255] and NCHW format (1x3x224x224)
    uint IndexR = 0 * 224 * 224 + DispatchThreadId.y * 224 + DispatchThreadId.x;
    uint IndexG = 1 * 224 * 224 + DispatchThreadId.y * 224 + DispatchThreadId.x;
    uint IndexB = 2 * 224 * 224 + DispatchThreadId.y * 224 + DispatchThreadId.x;

    OutputTensor[IndexR] = saturate(Color.r) * 255.0f;
    OutputTensor[IndexG] = saturate(Color.g) * 255.0f;
    OutputTensor[IndexB] = saturate(Color.b) * 255.0f;
}
