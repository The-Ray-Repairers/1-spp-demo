#include "/Engine/Public/Platform.ush"

Texture2D RawTexture;
Texture2D CurrentTexture;
SamplerState RawSampler;
float2 ViewMin;
float2 ViewSize;
float Split;
float ExposureRatio;

void MainPS(float4 Position : SV_POSITION, out float4 Color : SV_Target0)
{
    float2 UV = (Position.xy - ViewMin) / ViewSize;
    Color = CurrentTexture.Load(int3(int2(Position.xy), 0));
    if (UV.x < Split)
        Color = float4(RawTexture.SampleLevel(RawSampler, UV, 0).rgb * ExposureRatio, Color.a);
}
